{:paths   ["src/main" "resources"]

 :deps    {org.clojure/clojure        {:mvn/version "1.12.5"}
           com.fulcrologic/fulcro     {:mvn/version "3.9.5"}
           com.fulcrologic/fulcro-rad {:mvn/version "1.6.24"}
           com.fulcrologic/guardrails {:mvn/version "1.3.3"}
           datalevin/datalevin        {:mvn/version "1.0.0"}
           edn-query-language/eql     {:mvn/version "2025.09.27"}
           com.taoensso/timbre        {:mvn/version "6.8.0"}
           com.taoensso/encore        {:mvn/version "3.171.1"}}

 ;; Pathom is intentionally NOT a hard dependency of this library. The adapter
 ;; emits Pathom-2-shape resolver maps (plain data, no pathom required to build),
 ;; which work directly in a Pathom 2 parser and are auto-converted by RAD's
 ;; Pathom 3 processor. pathom3 is a test-only dependency, used to exercise the
 ;; P2->P3 conversion path. See generate-resolvers / generate-resolvers-pathom3.
 :aliases {:test    {:extra-paths ["src/test"]
                     :extra-deps  {fulcrologic/fulcro-spec {:mvn/version "3.2.10"}
                                   com.wsscode/pathom      {:mvn/version "2.4.0"}
                                   com.wsscode/pathom3     {:mvn/version "2025.01.16-alpha"}}}

           :run-tests {:extra-paths ["src/test"]
                       :extra-deps {lambdaisland/kaocha  {:mvn/version "1.91.1392"}
                                    com.wsscode/pathom   {:mvn/version "2.4.0"}
                                    com.wsscode/pathom3  {:mvn/version "2025.01.16-alpha"}}
                       :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                       :main-opts ["-m" "kaocha.runner"]}

           ;; Build via tools.build — see build.clj.  clojure -T:build jar | install
           :build   {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
                     :ns-default build}

           ;; Deploy to Clojars in an ISOLATED classpath (deps-deploy pulls legacy
           ;; maven/s3 libs that conflict with tools.build's maven-resolver, so it
           ;; must run in its own process). Reads coordinates from the pom inside
           ;; the jar. Needs CLOJARS_USERNAME + CLOJARS_PASSWORD (deploy token).
           ;;   clojure -T:build jar && clojure -X:deploy
           :deploy  {:replace-deps {slipset/deps-deploy {:mvn/version "0.2.5"}}
                     :exec-fn      deps-deploy.deps-deploy/deploy
                     :exec-args    {:installer :remote
                                    :artifact  "target/fulcro-rad-datalevin.jar"
                                    :pom-file  "target/classes/META-INF/maven/us.whitford/fulcro-rad-datalevin/pom.xml"}}
           ;; NOTE: antq exits 1 when outdated deps EXIST (by design, for CI
           ;; gating) — a non-zero exit with a results table is success.
           :outdated {:deps {com.github.liquidz/antq {:mvn/version "RELEASE"}
                             ;; silence "SLF4J: Failed to load class ..." noise
                             org.slf4j/slf4j-nop     {:mvn/version "2.0.18"}}
                      :main-opts ["-m" "antq.core"]}}}
